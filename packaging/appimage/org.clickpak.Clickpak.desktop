[Desktop Entry]
Type=Application
Name=Clickpak
GenericName=Universal Package Installer
Comment=Install .pkg.tar.zst, .AppImage, .flatpakref, archives and PKGBUILD files
Exec=clickpak %f
Terminal=false
MimeType=application/x-flatpakref;application/x-flatpak;application/x-iso9660-appimage;application/vnd.visualstudio.code.extension;application/x-shellscript;application/x-executable;application/java-archive;application/x-deb;application/x-rpm;application/gzip;application/x-xz;application/zstd;application/x-bzip2;application/x-tar;application/zip;
Categories=System;PackageManager;Utility;
Keywords=install;package;flatpak;appimage;arch;pacman;clickpak;
Icon=org.clickpak.Clickpak
StartupNotify=true
NoDisplay=false
