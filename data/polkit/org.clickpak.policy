<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Clickpak</vendor>
  <vendor_url>https://github.com/clickpak/clickpak</vendor_url>
  <icon_name>clickpak</icon_name>
  
  <action id="org.clickpak.install">
    <description>Install system packages</description>
    <description xml:lang="fr">Installer des paquets système</description>
    <message>Authentication is required to install system packages</message>
    <message xml:lang="fr">L'authentification est requise pour installer des paquets système</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/pacman</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">-U</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv2">--noconfirm</annotate>
  </action>
  
  <action id="org.clickpak.install.snap">
    <description>Install Snap packages</description>
    <description xml:lang="fr">Installer des paquets Snap</description>
    <message>Authentication is required to install Snap packages</message>
    <message xml:lang="fr">L'authentification est requise pour installer des paquets Snap</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/snap</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">install</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv2">--dangerous</annotate>
  </action>
</policyconfig>