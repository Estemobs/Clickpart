{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clickpart",
  "version": "0.6.0",
  "identifier": "org.clickpart.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clickpart",
        "width": 960,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "shortDescription": "Installateur graphique universel pour Linux",
    "longDescription": "Clickpak installe vos fichiers .pkg.tar.zst, .AppImage, .flatpakref, archives et PKGBUILD depuis une interface graphique simple.",
    "icon": [
      "icons/clickpart-32x32.png",
      "icons/clickpart-128x128.png",
      "icons/clickpart-128x128@2x.png",
      "icons/clickpart-icon.png"
    ]
  }
}
